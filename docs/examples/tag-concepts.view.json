    },
    "article-filter": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/article/service/impl/ArticleReadServiceImpl.java",
      "text": "public PageListVo<ArticleDTO> queryArticlesByTag(Long tagId, PageParam page) {\n        List<ArticleDO> records = articleDao.listRelatedArticlesOrderByReadCount(null, Arrays.asList(tagId), page);\n        return buildArticleListVo(records, page.getPageSize());"
    },
    "article-recommend": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/article/service/impl/ArticleRecommendServiceImpl.java",
      "text": "List<Long> tagIds = articleTagDao.listArticleTags(articleId).stream()\n                .map(ArticleTagDO::getTagId).collect(Collectors.toList());\n        if (CollectionUtils.isEmpty(tagIds)) {\n            return PageListVo.emptyVo();\n        }\n\n        List<ArticleDO> recommendArticles = articleDao.listRelatedArticlesOrderByReadCount(article.getCategoryId(), tagIds, page);"
    },
    "article-cache": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/article/service/impl/TagSettingServiceImpl.java",
      "text": "String redisKey = CACHE_TAG_PRE + tagId;\n\n        // 先查询缓存，如果有就直接返回\n        String tagInfoStr = RedisClient.getStr(redisKey);\n        if (tagInfoStr != null && !tagInfoStr.isEmpty()) {\n            return JsonUtil.toObj(tagInfoStr, TagDTO.class);"
    },
    "config-kinds": {
      "path": "paicoding-api/src/main/java/com/github/paicoding/forum/api/model/enums/ConfigTagEnum.java",
      "text": "EMPTY(0, \"\"),\n    HOT(1, \"热门\"),\n    OFFICAL(2, \"官方\"),\n    COMMENT(3, \"推荐\"),"
    },
    "config-storage": {
      "path": "paicoding-api/src/main/java/com/github/paicoding/forum/api/model/vo/banner/dto/ConfigDTO.java",
      "text": "     * 配置相关的标签：如 火，推荐，精选 等等，英文逗号分隔\n     *\n     * @see ConfigTagEnum#getCode()\n     */\n    private String tags;"
    },
    "config-render": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/sidebar/service/SidebarServiceImpl.java",
      "text": "String tagsDesc = \"\";\n        if (StringUtils.isNotBlank(config.getTags())) {\n            tagsDesc = Splitter.on(\",\").splitToStream(config.getTags())\n                    .map(s -> ConfigTagEnum.formCode(Integer.parseInt(s.trim())).getDesc())\n                    .collect(Collectors.joining(\",\"));\n        }\n        return new SideBarDTO().setTitle(tagsDesc).setSubTitle(config.getName())"
    },
    "ui-select": {
