    "suspend": {
      "html": "<style>body{margin:0;line-height:1.5}.kind{font-size:12px;opacity:.7}.lanes{display:grid;grid-template-columns:60px 1fr;gap:10px;margin:14px 0}.value{padding:5px 9px;background:var(--demo-hover,#8882);border-radius:5px}.active{color:var(--demo-primary,#589df6)}.actions{display:flex;gap:8px}button{padding:5px 10px;border:1px solid var(--demo-border,#8885);border-radius:5px;background:transparent;color:inherit;cursor:pointer}button:hover{background:var(--demo-hover,#8882)}button:disabled{opacity:.45;cursor:default}button:focus-visible{outline:2px solid var(--demo-primary,#589df6);outline-offset:2px}</style>\n <div class=\"kind\">演示推演 · 非运行记录 · 同一线程</div>\n <div class=\"lanes\"><span>任务 A</span><span id=\"a\" class=\"value\"></span><span>任务 B</span><span id=\"b\" class=\"value\"></span><span>线程</span><span id=\"thread\" class=\"value active\"></span></div>\n <div class=\"actions\"><button id=\"next\">推进一步</button><button id=\"reset\">重置</button></div>\n <script>\n const mode=\"suspend\",steps=[\"await\",\"b\",\"resume\"],frames=[[\"等待\",\"待执行\",\"可用于其他任务\"],[\"等待\",\"完成\",\"刚执行 B\"],[\"继续执行\",\"完成\",\"恢复 A\"]];let index=0;\n function render(){for(const [n,id] of [\"a\",\"b\",\"thread\"].entries())document.getElementById(id).textContent=frames[index][n];document.getElementById(\"next\").disabled=index===steps.length-1}\n function choose(next){index=next;render();parent.postMessage({channel:\"lessplain-demo\",method:\"setState\",params:{path:\"/\"+mode+\"/step\",value:steps[index]}},\"*\")}\n document.getElementById(\"next\").onclick=()=>choose(Math.min(steps.length-1,index+1));document.getElementById(\"reset\").onclick=()=>choose(0);\n addEventListener(\"message\",e=>{if(e.source!==parent||e.data?.channel!==\"lessplain-demo\"||e.data?.method!==\"state\")return;const found=steps.indexOf(e.data.params?.state?.[mode]?.step);if(found>=0){index=found;render()}});render();\n </script>"
    },
    "blocking": {
      "html": "<style>body{margin:0;line-height:1.5}.kind{font-size:12px;opacity:.7}.lanes{display:grid;grid-template-columns:60px 1fr;gap:10px;margin:14px 0}.value{padding:5px 9px;background:var(--demo-hover,#8882);border-radius:5px}.active{color:var(--demo-primary,#589df6)}.actions{display:flex;gap:8px}button{padding:5px 10px;border:1px solid var(--demo-border,#8885);border-radius:5px;background:transparent;color:inherit;cursor:pointer}button:hover{background:var(--demo-hover,#8882)}button:disabled{opacity:.45;cursor:default}button:focus-visible{outline:2px solid var(--demo-primary,#589df6);outline-offset:2px}</style>\n <div class=\"kind\">演示推演 · 非运行记录 · 同一线程</div>\n <div class=\"lanes\"><span>任务 A</span><span id=\"a\" class=\"value\"></span><span>任务 B</span><span id=\"b\" class=\"value\"></span><span>线程</span><span id=\"thread\" class=\"value active\"></span></div>\n <div class=\"actions\"><button id=\"next\">推进一步</button><button id=\"reset\">重置</button></div>\n <script>\n const mode=\"blocking\",steps=[\"await\",\"resume\",\"b\"],frames=[[\"阻塞等待\",\"待执行\",\"被 A 占用\"],[\"结束等待\",\"待执行\",\"A 才释放线程\"],[\"完成\",\"执行\",\"执行 B\"]];let index=0;\n function render(){for(const [n,id] of [\"a\",\"b\",\"thread\"].entries())document.getElementById(id).textContent=frames[index][n];document.getElementById(\"next\").disabled=index===steps.length-1}\n function choose(next){index=next;render();parent.postMessage({channel:\"lessplain-demo\",method:\"setState\",params:{path:\"/\"+mode+\"/step\",value:steps[index]}},\"*\")}\n document.getElementById(\"next\").onclick=()=>choose(Math.min(steps.length-1,index+1));document.getElementById(\"reset\").onclick=()=>choose(0);\n addEventListener(\"message\",e=>{if(e.source!==parent||e.data?.channel!==\"lessplain-demo\"||e.data?.method!==\"state\")return;const found=steps.indexOf(e.data.params?.state?.[mode]?.step);if(found>=0){index=found;render()}});render();\n </script>"
