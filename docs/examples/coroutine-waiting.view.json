{
  "title": "等待时线程能做什么？",
  "question": "Kotlin 协程挂起等待与阻塞等待有什么区别？",
  "codeSamples": {
    "suspend": {
      "title": "挂起等待",
      "language": "kotlin",
      "code": "import kotlinx.coroutines.*\n\nfun main() = runBlocking {\n    launch {\n        println(\"A 开始等待\")\n        delay(1000) // 模拟等待；真实 HTTP 客户端由其挂起 API 等待响应\n        println(\"A 继续\")\n    }\n    launch {\n        println(\"B 执行\")\n    }\n}\n"
    },
    "blocking": {
      "title": "阻塞等待",
      "language": "kotlin",
      "code": "import kotlinx.coroutines.*\n\nfun main() = runBlocking {\n    launch {\n        println(\"A 开始等待\")\n        Thread.sleep(1000) // 占住 runBlocking 的同一线程\n        println(\"A 继续\")\n    }\n    launch {\n        println(\"B 执行\")\n    }\n}\n"
    }
  },
