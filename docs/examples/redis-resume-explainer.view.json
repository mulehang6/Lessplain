  "sources": {
    "home-cache": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/sidebar/service/SidebarServiceImpl.java",
      "text": "@Cacheable(key = \"'homeSidebar'\", cacheManager = \"caffeineCacheManager\", cacheNames = \"home\")\n    public List<SideBarDTO> queryHomeSidebarList() {"
    },
    "hot-eight": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/sidebar/service/SidebarServiceImpl.java",
      "text": "private SideBarDTO hotArticles() {\n        PageListVo<SimpleArticleDTO> vo = articleReadService.queryHotArticlesForRecommend(PageParam.newPageInstance(1, 8));"
    },
    "hot-sql": {
      "path": "paicoding-service/src/main/resources/mapper/ArticleMapper.xml",
      "text": "<select id=\"listArticlesByReadCounts\"\n            resultType=\"com.github.paicoding.forum.api.model.vo.article.dto.SimpleArticleDTO\">\n        select rc.document_id as id, a.user_id as authorId, a.title as title, a.create_time as createTime\n        from read_count as rc left join article as a on rc.document_id = a.id\n        where rc.document_type = ${@com.github.paicoding.forum.api.model.enums.DocumentTypeEnum@ARTICLE.code}\n        and a.status = ${@com.github.paicoding.forum.api.model.enums.PushStatusEnum@ONLINE.code}\n        and a.deleted = ${@com.github.paicoding.forum.api.model.enums.YesOrNoEnum@NO.code} order by rc.cnt desc\n        <include refid=\"limit\"/>\n    </select>"
    },
    "home-ttl": {
      "path": "paicoding-core/src/main/java/com/github/paicoding/forum/core/ForumCoreAutoConfig.java",
      "text": ".expireAfterWrite(5, TimeUnit.MINUTES)"
    },
    "rank-event": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/rank/service/listener/UserActivityListener.java",
      "text": "@Async\n    @EventListener(ArticleMsgEvent.class)\n    public void publishArticleListener(ArticleMsgEvent<ArticleDO> event) {\n        ArticleEventEnum type = event.getType();\n        if (type == ArticleEventEnum.ONLINE) {\n            userActivityRankService.addActivityScore(ReqInfoContext.getReqInfo().getUserId(), new ActivityScoreBo().setPublishArticle(true).setArticleId(event.getContent().getId()));"
    },
    "rank-score": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/rank/service/impl/UserActivityRankServiceImpl.java",
      "text": "} else if (BooleanUtils.isTrue(activityScore.getPublishArticle())) {\n                // 发布文章\n                field += \"publish\";\n                score += 10;"
    },
    "rank-gate": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/rank/service/impl/UserActivityRankServiceImpl.java",
      "text": "Integer recordedScore = RedisClient.hGet(userActionKey, field, Integer.class);\n        if (recordedScore == null) {\n            // 2.1 之前没有加分记录，执行具体的加分\n            if (score > 0) {\n                // 记录加分记录\n                RedisClient.hSet(userActionKey, field, score);"
    },
    "rank-zsets": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/rank/service/impl/UserActivityRankServiceImpl.java",
      "text": "Double updatedScore = RedisClient.zIncrBy(todayRankKey, String.valueOf(userId), score);\n                RedisClient.zIncrBy(monthRankKey, String.valueOf(userId), score);"
    },
    "rank-page": {
      "path": "paicoding-web/src/main/java/com/github/paicoding/forum/web/front/rank/RankController.java",
      "text": "@RequestMapping(path = \"/rank/{time}\")\n    public String rank(@PathVariable String time, Model model) {\n        ActivityRankTimeEnum rankTime = ActivityRankTimeEnum.nameOf(time);\n        if (rankTime == null) {\n            rankTime = ActivityRankTimeEnum.MONTH;\n        }\n        List<RankItemDTO> list = userActivityRankService.queryRankList(rankTime, 30);"
    },
    "rank-query": {
      "path": "paicoding-service/src/main/java/com/github/paicoding/forum/service/rank/service/impl/UserActivityRankServiceImpl.java",
