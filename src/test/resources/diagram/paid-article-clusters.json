    },
    {
      "id": "confirm_save",
      "label": "无变化/写失败短路，否则发布",
      "kind": "step"
    },
    {
      "id": "author_callback",
      "label": "作者确认入口选择 EMAIL",
      "kind": "step"
    },
    {
      "id": "callback_guard",
      "label": "锁记录并核对校验码",
      "kind": "step"
    },
    {
      "id": "callback_idempotent",
      "label": "相同状态或已成功：幂等返回",
      "kind": "step"
    },
    {
      "id": "callback_save",
      "label": "回写状态、时间与第三方单号",
