    },
    {
      "id": "publish",
      "label": "PAYING 与成功/失败分别发事件",
      "kind": "step"
    },
    {
      "id": "event",
      "label": "发布进程内通知事件",
      "kind": "step"
    },
    {
      "id": "listener",
      "label": "异步消费 PAYING/PAY",
      "kind": "step"
    },
    {
      "id": "recipient",
      "label": "PAYING 通知作者，终态通知买家",
      "kind": "step"
    },
    {
      "id": "notice_save",
      "label": "按历史与文案决定新增通知",
      "kind": "step"
    },
    {
      "id": "notice_status",
      "label": "按 PAYING/成功/失败选择消息",
      "kind": "step"
    },
    {
      "id": "websocket",
      "label": "向在线会话发送 JSON 消息",
      "kind": "step"
    },
    {
      "id": "read_gate",
      "label": "付费文章核对登录用户与作者",
      "kind": "step"
    },
    {
      "id": "has_paid",
      "label": "数据库状态是否为 SUCCEED？",
      "kind": "step"
    },
    {
      "id": "read_result",
      "label": "有权限返回全文，否则截取预览",
      "kind": "step"
    }
