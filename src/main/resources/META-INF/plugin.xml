<!-- 插件配置文件，更多说明：https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件唯一标识应使用全限定名，插件版本之间不能随意修改。 -->
    <id>com.master.lessplain.lessplain</id>

    <!-- 公开插件名称使用标题式大小写，规范：https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Lessplain</name>

    <!-- 在插件页面显示的厂商名称或组织 ID。 -->
    <vendor>Lessplain</vendor>

    <!-- 插件页面和 IDE 插件管理器中的描述，规范：https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Lessplain stores code comprehension graphs, source evidence, and follow-up answers inside IntelliJ IDEA projects.
        ]]></description>

    <!-- 产品和插件兼容要求，更多说明：https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.compose</depends>
    <depends>com.intellij.mcpServer</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- 插件定义的扩展，更多说明：https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.lessplain.ide.UnderstandingService"/>
        <fileEditorProvider implementation="com.lessplain.diagram.UnderstandingFileEditorProvider"/>
        <editorTabTitleProvider implementation="com.lessplain.diagram.UnderstandingTabTitleProvider"/>
        <toolWindow id="Understanding" factoryClass="com.lessplain.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <notificationGroup id="code.comprehension.results" displayType="BALLOON"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <mcpToolset implementation="com.lessplain.mcp.UnderstandingToolset"/>
    </extensions>
    <actions>
        <action id="Lessplain.AskSelectedCode" class="com.lessplain.ui.AskSelectedCodeAction"
                text="提问" description="将所选代码的问题添加到当前源码节点" icon="AllIcons.General.QuestionDialog">
            <add-to-group group-id="Floating.CodeToolbar" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
